# ==============================================================================
# TryLo Backend Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' inside the backend/ folder:
#   Windows PowerShell: Copy-Item .env.example .env
#   Never commit the real '.env' file containing passwords or secrets to Git.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins
# Comma-separated list of origins allowed to access the backend API (never use wildcard with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection String
# ------------------------------------------------------------------------------
# Obtain this from your Supabase Dashboard:
# Project Settings -> Database -> Connection string (URI)
#
# Driver format: postgresql+psycopg://[user]:[password]@[host]:[port]/[database]?sslmode=require
#
# NOTE:
# 1. Supabase provides URLs starting with 'postgresql://'.
#    Our backend automatically normalizes 'postgresql://' to 'postgresql+psycopg://'.
# 2. If your password has special characters (e.g. '@', '#', '%'), make sure they are URL-encoded.
# 3. Connection Modes:
#    - Direct Connection (Default Port 5432):
#      postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#    - Session Pooler (Port 5432) or Transaction Pooler (Port 6543):
#      Useful for environments with transient or serverless connections.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Database Connection Timeout in Seconds (used for connection checks and health queries)
DB_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------------------
# JWT Authentication & Cookie Security (Phase 1B)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (must be at least 32 random characters).
# Generate a strong key with PowerShell / Python:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In production, the backend will fail to start if this is missing or using default.
JWT_SECRET_KEY=trylo-dev-secret-key-change-in-production-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cookie Configuration
COOKIE_NAME=trylo_access_token
CSRF_COOKIE_NAME=trylo_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
# Set COOKIE_SECURE to true for HTTPS production; in development, leave empty or false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Login Rate Limiting (in-memory per IP / email)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
